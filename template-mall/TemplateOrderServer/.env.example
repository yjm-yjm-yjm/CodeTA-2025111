GRPC_ADDR=:50051

# Deployments 将 MySQL 映射到宿主机 3308（容器内仍为 3306）
MYSQL_DSN=root:root@tcp(127.0.0.1:3308)/template_order_db?charset=utf8mb4&parseTime=True&loc=Local

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=template-pay-events
KAFKA_CONSUMER_GROUP=template-order-consumer-group

PAY_BASE_URL=http://127.0.0.1:8082
PAY_HTTP_TIMEOUT=5s

DOWNLOAD_URL_TTL=30s

# mock | aliyun
STORAGE_PROVIDER=aliyun
OSS_ENDPOINT=oss-cn-wuhan-lr.aliyuncs.com
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=yangjiaminbucket
OSS_REGION=cn-wuhan-lr
MOCK_SIGN_SECRET=dev-mock-sign-secret
