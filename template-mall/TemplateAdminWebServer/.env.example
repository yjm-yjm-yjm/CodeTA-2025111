HTTP_ADDR=:8081
PUBLIC_BASE_URL=http://127.0.0.1:8081

ORDER_GRPC_ADDR=127.0.0.1:50051
GRPC_TIMEOUT=5s

JWT_SECRET=dev-admin-jwt-secret-change-me
JWT_TTL=12h

# mock | wps
AUTH_MODE=mock
ADMIN_FRONTEND_URL=http://localhost:3001

WPS_CLIENT_ID=
WPS_CLIENT_SECRET=
# 须与开放平台登记完全一致（含 host/port/path）
WPS_REDIRECT_URI=http://localhost:3001/api/auth/callback
WPS_AUTH_URL=https://openapi.wps.cn/oauth2/auth
WPS_TOKEN_URL=https://openapi.wps.cn/oauth2/token
WPS_USERINFO_URL=https://openapi.wps.cn/v7/users/current
WPS_SCOPES=kso.user_base.read

# mock | aliyun
# aliyun：浏览器对预签名 URL 签名直传；启动时会尝试写入桶 CORS（允许 localhost:3001 等）
OSS_PROVIDER=aliyun
OSS_ENDPOINT=oss-cn-wuhan-lr.aliyuncs.com
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=yangjiaminbucket
OSS_UPLOAD_TTL=15m
